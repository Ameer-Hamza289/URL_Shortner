<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener with Rate Limiting</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            padding-top: 2rem;
            background-color: #f8f9fa;
        }
        .card {
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        .form-control:focus {
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
            border-color: #86b7fe;
        }
        #result {
            display: none;
            margin-top: 20px;
        }
        .short-url {
            word-break: break-all;
        }
        .loading {
            display: none;
            text-align: center;
            margin: 20px 0;
        }
        .spinner-border {
            width: 2rem;
            height: 2rem;
        }
        .rate-limit-info {
            background-color: #e2f4fd;
            border-radius: 8px;
            padding: 15px;
            margin-top: 30px;
        }
        .footer {
            margin-top: 40px;
            padding: 20px 0;
            background: #f1f1f1;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h1 class="h4 mb-0">URL Shortener</h1>
                    </div>
                    <div class="card-body">
                        <form id="urlForm">
                            <div class="mb-3">
                                <label for="longUrl" class="form-label">Enter your long URL</label>
                                <input type="url" class="form-control" id="longUrl" 
                                    placeholder="https://example.com/very/long/url/that/needs/shortening" required>
                                <div class="form-text">Include http:// or https:// in your URL</div>
                            </div>
                            <div class="mb-3">
                                <label for="customAlias" class="form-label">Custom alias (optional)</label>
                                <input type="text" class="form-control" id="customAlias" 
                                    placeholder="my-custom-link" pattern="[a-zA-Z0-9_-]+">
                                <div class="form-text">Letters, numbers, hyphens and underscores only</div>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Shorten URL</button>
                        </form>
                        
                        <div id="loading" class="loading">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p>Creating your short URL...</p>
                        </div>
                        
                        <div id="result" class="alert alert-success">
                            <h5>Your shortened URL:</h5>
                            <div class="input-group mb-3">
                                <input type="text" id="shortUrl" class="form-control short-url" readonly>
                                <button class="btn btn-outline-secondary" type="button" id="copyButton">
                                    Copy
                                </button>
                            </div>
                            <p>Original URL: <span id="originalUrl" class="text-truncate d-inline-block w-100"></span></p>
                            <div class="d-flex justify-content-between mt-3">
                                <a id="visitLink" href="#" target="_blank" class="btn btn-outline-primary">Visit Link</a>
                                <a id="statsLink" href="#" class="btn btn-outline-secondary">View Stats</a>
                            </div>
                        </div>
                        
                        <div id="error" class="alert alert-danger mt-3" style="display:none;">
                            <h5 id="errorTitle">Error</h5>
                            <p id="errorMessage"></p>
                        </div>
                    </div>
                </div>
                
                <div class="rate-limit-info mt-4">
                    <h5>Rate Limiting Information</h5>
                    <p>This application uses several rate limits to prevent abuse:</p>
                    <ul>
                        <li><strong>URL Creation:</strong> 5 URLs per minute per IP address</li>
                        <li><strong>URL Redirection:</strong> 10 redirects every 3 seconds per IP address</li>
                        <li><strong>URL Stats:</strong> 5 stats requests every 10 seconds per IP address</li>
                    </ul>
                    <p>When a rate limit is exceeded, you'll receive a 429 error with information about when you can try again.</p>
                </div>
            </div>
        </div>
        
        <div class="footer">
            <p>URL Shortener with Rate Limiting | Built with Express.js and Redis</p>
        </div>
    </div>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('urlForm');
            const loading = document.getElementById('loading');
            const result = document.getElementById('result');
            const error = document.getElementById('error');
            const errorTitle = document.getElementById('errorTitle');
            const errorMessage = document.getElementById('errorMessage');
            const shortUrlInput = document.getElementById('shortUrl');
            const originalUrlSpan = document.getElementById('originalUrl');
            const visitLink = document.getElementById('visitLink');
            const statsLink = document.getElementById('statsLink');
            const copyButton = document.getElementById('copyButton');
            
            form.addEventListener('submit', async function(e) {
                e.preventDefault();
                
                // Reset UI
                result.style.display = 'none';
                error.style.display = 'none';
                loading.style.display = 'block';
                
                const longUrl = document.getElementById('longUrl').value;
                const customAlias = document.getElementById('customAlias').value;
                
                try {
                    const response = await fetch('/api/url/shorten', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            longUrl,
                            customAlias: customAlias || undefined
                        })
                    });
                    
                    loading.style.display = 'none';
                    
                    const data = await response.json();
                    
                    if (response.ok) {
                        // Show success
                        shortUrlInput.value = data.shortUrl;
                        originalUrlSpan.textContent = data.longUrl;
                        originalUrlSpan.title = data.longUrl;
                        visitLink.href = data.shortUrl;
                        statsLink.href = `/api/url/${data.shortId}/stats`;
                        result.style.display = 'block';
                    } else {
                        // Show error
                        errorTitle.textContent = data.error;
                        errorMessage.textContent = data.message;
                        error.style.display = 'block';
                    }
                } catch (err) {
                    loading.style.display = 'none';
                    errorTitle.textContent = 'Connection Error';
                    errorMessage.textContent = 'Could not connect to the server. Please try again.';
                    error.style.display = 'block';
                }
            });
            
            // Copy button functionality
            copyButton.addEventListener('click', function() {
                shortUrlInput.select();
                document.execCommand('copy');
                copyButton.textContent = 'Copied!';
                setTimeout(() => {
                    copyButton.textContent = 'Copy';
                }, 2000);
            });
        });
    </script>
</body>
</html> 