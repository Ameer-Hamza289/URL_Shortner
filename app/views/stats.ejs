<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Stats - URL Shortener</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            padding-top: 2rem;
            background-color: #f8f9fa;
        }
        .card {
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        .stats-value {
            font-size: 2.5rem;
            font-weight: bold;
            color: #0d6efd;
        }
        .stats-label {
            color: #6c757d;
            font-size: 0.9rem;
            text-transform: uppercase;
        }
        .original-url {
            word-break: break-all;
        }
        .loading {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 300px;
            flex-direction: column;
        }
        .error-container {
            display: none;
            text-align: center;
            padding: 2rem;
        }
        .stats-container {
            display: none;
        }
        .footer {
            margin-top: 40px;
            padding: 20px 0;
            background: #f1f1f1;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="card">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h1 class="h4 mb-0">URL Statistics</h1>
                        <a href="/" class="btn btn-sm btn-light">Back to Shortener</a>
                    </div>
                    
                    <div id="loading" class="loading">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-3">Loading statistics...</p>
                    </div>
                    
                    <div id="stats-container" class="stats-container">
                        <div class="card-body">
                            <div class="mb-4">
                                <h5>Short URL</h5>
                                <div class="input-group">
                                    <input type="text" id="shortUrl" class="form-control" readonly>
                                    <button class="btn btn-outline-secondary" type="button" id="copyButton">
                                        Copy
                                    </button>
                                </div>
                            </div>
                            
                            <div class="mb-4">
                                <h5>Original URL</h5>
                                <p id="originalUrl" class="original-url"></p>
                            </div>
                            
                            <div class="row text-center g-4">
                                <div class="col-md-4">
                                    <div class="p-3">
                                        <div class="stats-value" id="hits">0</div>
                                        <div class="stats-label">Total Clicks</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3">
                                        <div class="stats-value" id="created">-</div>
                                        <div class="stats-label">Created</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3">
                                        <div class="stats-value" id="expires">-</div>
                                        <div class="stats-label">Expires In</div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
                                <a id="visitLink" href="#" target="_blank" class="btn btn-primary">
                                    Visit Original URL
                                </a>
                                <button id="refreshStats" class="btn btn-outline-secondary">
                                    Refresh Stats
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <div id="error-container" class="error-container">
                        <h3 id="errorTitle" class="text-danger">Error</h3>
                        <p id="errorMessage"></p>
                        <a href="/" class="btn btn-primary">Go Back Home</a>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="footer">
            <p>URL Shortener with Rate Limiting | Built with Express.js and Redis</p>
        </div>
    </div>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const loading = document.getElementById('loading');
            const statsContainer = document.getElementById('stats-container');
            const errorContainer = document.getElementById('error-container');
            const shortUrlInput = document.getElementById('shortUrl');
            const originalUrlP = document.getElementById('originalUrl');
            const hitsDiv = document.getElementById('hits');
            const createdDiv = document.getElementById('created');
            const expiresDiv = document.getElementById('expires');
            const visitLink = document.getElementById('visitLink');
            const refreshStats = document.getElementById('refreshStats');
            const copyButton = document.getElementById('copyButton');
            const errorTitle = document.getElementById('errorTitle');
            const errorMessage = document.getElementById('errorMessage');
            
            // Get shortId from URL
            const urlParts = window.location.pathname.split('/');
            const shortId = urlParts[urlParts.length - 2]; // Format: /api/url/:shortId/stats
            
            // Function to load stats
            async function loadStats() {
                loading.style.display = 'flex';
                statsContainer.style.display = 'none';
                errorContainer.style.display = 'none';
                
                try {
                    const response = await fetch(`/api/url/${shortId}/stats`);
                    const data = await response.json();
                    
                    loading.style.display = 'none';
                    
                    if (response.ok) {
                        // Format the data
                        const baseUrl = `${window.location.protocol}//${window.location.host}`;
                        const shortUrl = `${baseUrl}/${data.shortId}`;
                        const created = new Date(data.created);
                        
                        // Update UI
                        shortUrlInput.value = shortUrl;
                        originalUrlP.textContent = data.originalUrl;
                        originalUrlP.title = data.originalUrl;
                        hitsDiv.textContent = data.hits;
                        createdDiv.textContent = formatDate(created);
                        expiresDiv.textContent = `${data.expiresInDays} days`;
                        visitLink.href = data.originalUrl;
                        
                        statsContainer.style.display = 'block';
                    } else {
                        // Show error
                        errorTitle.textContent = data.error;
                        errorMessage.textContent = data.message;
                        errorContainer.style.display = 'block';
                    }
                } catch (err) {
                    loading.style.display = 'none';
                    errorTitle.textContent = 'Connection Error';
                    errorMessage.textContent = 'Could not load statistics. Please try again.';
                    errorContainer.style.display = 'block';
                }
            }
            
            // Format date helper
            function formatDate(date) {
                const now = new Date();
                const diff = now - date;
                
                // If less than a day, show hours
                if (diff < 24 * 60 * 60 * 1000) {
                    const hours = Math.floor(diff / (60 * 60 * 1000));
                    return hours < 1 ? 'Just now' : `${hours}h ago`;
                }
                
                // If less than a week, show days
                if (diff < 7 * 24 * 60 * 60 * 1000) {
                    const days = Math.floor(diff / (24 * 60 * 60 * 1000));
                    return `${days}d ago`;
                }
                
                // Otherwise show date
                return date.toLocaleDateString();
            }
            
            // Load stats initially
            loadStats();
            
            // Refresh button
            refreshStats.addEventListener('click', loadStats);
            
            // Copy button
            copyButton.addEventListener('click', function() {
                shortUrlInput.select();
                document.execCommand('copy');
                copyButton.textContent = 'Copied!';
                setTimeout(() => {
                    copyButton.textContent = 'Copy';
                }, 2000);
            });
        });
    </script>
</body>
</html>